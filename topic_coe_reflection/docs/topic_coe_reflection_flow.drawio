        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#3A8E77;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="channels" target="handoff">
