          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;阅读提示&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;圆盘源多个点按 Σ w_s |U_s|² 累加。膜堆只采用法向局部系数；传播采用标量近轴远场，尚未计算斜入射膜堆、矢量偏振或近场耦合。&lt;/span&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#C58B45;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2160" width="1760" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="metrics" name="04 指标色度与输出">
    <mxGraphModel dx="1800" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="2180" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;后处理｜原始能量 → 指标、颜色与导出文件&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;所有定量统计使用未经 dB / 曝光 / 对数增强的 spectralEnergy；以下四列是数据分支，不表示必须同时运行&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#173555;strokeColor=#173555;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=25;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="2020" height="66" as="geometry" />
        </mxCell>
        <mxCell id="l0" value="&lt;b&gt;A 反射总量与能量占比&lt;/b&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#D7E0EA;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=15;shadow=0;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="475" height="45" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="&lt;b&gt;B 观察角域与累计曲线&lt;/b&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#D7E0EA;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=15;shadow=0;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="555" y="115" width="475" height="45" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;C 非零级亮斑与固定 ROI&lt;/b&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#D7E0EA;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=15;shadow=0;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1070" y="115" width="475" height="45" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;D 光谱权重与颜色显示&lt;/b&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#D7E0EA;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=15;shadow=0;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1585" y="115" width="475" height="45" as="geometry" />
        </mxCell>
        <mxCell id="physical" value="&lt;b&gt;共同输入：result / baseline&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;e_{p,k}=spectralEnergy(p,k) [像素能量/入射]；T_k=Throughput；C_k=CapturedThroughput&lt;br&gt;zeroOrderRadiusFactor、metricAngleDeg、observation、spotOptions；无额外高度时只统计单状态&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="185" width="1505" height="120" as="geometry" />
        </mxCell>
        <mxCell id="weights" value="&lt;b&gt;coreLoadSpectrum：一次构造权重&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;a_k=SPD_k·Δλ_k（梯形端点半权重）&lt;br&gt;wE_k=a_k/Σa；wV_k=a_k·ȳ_k/Σa·ȳ&lt;br&gt;WXYZ_k=a_k·[x̄,ȳ,z̄]/Σa·ȳ&lt;br&gt;单色谱线 Δλ=1；WXYZ 三通道用同一分母&lt;br&gt;RGB 模式使用代理权重，非标准色度&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1585" y="185" width="475" height="185" as="geometry" />
        </mxCell>
        <mxCell id="ratio" value="&lt;b&gt;1 总反射、窗口捕获与守恒&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;总反射率 T_k=总反射/入射&lt;br&gt;窗口绝对反射率 C_k=Σ_p e_{p,k}&lt;br&gt;窗口捕获比例=C_k/T_k&lt;br&gt;ParsevalAbsoluteError：独立 FFT 校验误差&lt;br&gt;窗口外反射绝对量=T_k−C_k&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="475" height="155" as="geometry" />
        </mxCell>
        <mxCell id="zero" value="&lt;b&gt;2 零级能量与保持率&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;零级 ROI：|θ|≤a0·λ/pitch，a0 默认 0.45&lt;br&gt;ZeroOrderFraction=Σ_ROI e/T_k&lt;br&gt;零级绝对反射率=Σ_ROI e&lt;br&gt;ZeroOrderRetention=有高度占比/基线占比&lt;br&gt;高度全零且分母非零时保持率=1&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="475" height="155" as="geometry" />
        </mxCell>
        <mxCell id="haze" value="&lt;b&gt;3 锥外占比：模型雾度代理&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;评价圆锥 |θ|≤metricAngleDeg&lt;br&gt;OutsideAngleFraction=1−Σ_圆锥 e/T_k&lt;br&gt;包括观察窗口之外的反射能量&lt;br&gt;锥外绝对反射率=T_k·OutsideAngleFraction&lt;br&gt;不是 ASTM D1003 标准透射雾度&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="475" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ratioout" value="&lt;b&gt;4 comparisonMetrics 与逐波长表&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;TotalReflectancePercent=100 T_k&lt;br&gt;ZeroOrderPercent=100·零级占比&lt;br&gt;ReflectionHazeProxyPercent=100·锥外占比&lt;br&gt;同时给出以入射为分母的绝对反射率&lt;br&gt;记录半角、全角，避免 2.5°/5° 混用&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEE9FA;strokeColor=#8A70B0;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1095" width="475" height="170" as="geometry" />
        </mxCell>
        <mxCell id="roi" value="&lt;b&gt;coreComputeAngularMetrics&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;ρ=距离 observation.centerDeg 的角距离&lt;br&gt;圆锥：ρ≤outer；环带：inner&amp;lt;ρ≤outer&lt;br&gt;ROI 必须完整在输出窗口内&lt;br&gt;以输出 bin 中心判断是否纳入 ROI&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="555" y="420" width="475" height="155" as="geometry" />
        </mxCell>
        <mxCell id="integrate" value="&lt;b&gt;先按角域积分，再按光谱加权&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;v_k=Σ_ROI e_{p,k}&lt;br&gt;辐射度绝对反射率 = Σ_k v_k wE_k&lt;br&gt;明视觉绝对反射率 = Σ_k v_k wV_k&lt;br&gt;全反射加权用 T_k，窗口加权用 C_k&lt;br&gt;不能直接平均各波长的相对占比&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="555" y="640" width="475" height="155" as="geometry" />
        </mxCell>
        <mxCell id="cumulative" value="&lt;b&gt;累计曲线与观察色坐标&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;按各 bin 到观察中心距离排序并累加&lt;br&gt;R_k(α)=Σ_{ρ≤α} e_{p,k}&lt;br&gt;曲线从中心累计，不减环带内孔&lt;br&gt;保留 inner / outer 的精确边界采样&lt;br&gt;观察 XYZ=vᵀWXYZ，xy=(X,Y)/(X+Y+Z)&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="555" y="860" width="475" height="170" as="geometry" />
        </mxCell>
        <mxCell id="angularout" value="&lt;b&gt;角域输出&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;observationMetrics：角域/总量/窗口绝对反射率&lt;br&gt;辐射度与明视觉分别给出；可选 xy&lt;br&gt;cumulativeMetrics：半角 α 及累计反射率&lt;br&gt;withoutAngular / withAngular：含逐波长值&lt;br&gt;高度为零时复用一次积分结果&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEE9FA;strokeColor=#8A70B0;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="555" y="1095" width="475" height="170" as="geometry" />
        </mxCell>
        <mxCell id="groups" value="&lt;b&gt;coreComputeDiffractionSpots&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;分组：选定波长 + 宽带 radiant + photopic&lt;br&gt;宽带图先用 wE / wV 加权 e&lt;br&gt;对比时 reference=max(两状态能量图)&lt;br&gt;只用于共同定位，最终积分仍各用原图&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1070" y="420" width="475" height="155" as="geometry" />
        </mxCell>
        <mxCell id="detect" value="&lt;b&gt;候选峰筛选与共同中心&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;8 邻域局部极大且有严格较小邻点&lt;br&gt;避开零级排除圆，积分圆不能越界&lt;br&gt;峰高≥排除区外最强峰×minRelativePeak&lt;br&gt;按候选积分圆能量降序，索引打破同分&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1070" y="640" width="475" height="155" as="geometry" />
        </mxCell>
        <mxCell id="spotroi" value="&lt;b&gt;固定 ROI 积分与去重&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;按 minSeparation / 2×积分半角选峰&lt;br&gt;最多 maxSpots；同组积分圆不重叠&lt;br&gt;两状态使用同中心、同半角的圆&lt;br&gt;绝对反射率%=100·Σ_ROI e_group&lt;br&gt;共享边界 bin 只归前一个 ROI&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1070" y="860" width="475" height="170" as="geometry" />
        </mxCell>
        <mxCell id="spotsout" value="&lt;b&gt;spotMetrics + 标记&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;导出中心、峰位置、半角、状态、反射率%&lt;br&gt;S1/S2… 是检测编号，不等同理论 (m,n) 阶次&lt;br&gt;不同光谱组不能将反射率重复相加&lt;br&gt;标记开关只影响图形，不改变 CSV/积分&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEE9FA;strokeColor=#8A70B0;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1070" y="1095" width="475" height="170" as="geometry" />
        </mxCell>
        <mxCell id="xyz" value="&lt;b&gt;coreSynthesizeColor：标准光谱路径&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;XYZ_p=Σ_k e_{p,k}·WXYZ_k&lt;br&gt;xy=(X,Y)/(X+Y+Z)，无信号处 NaN&lt;br&gt;XYZDensity=XYZ/(Δθ)²&lt;br&gt;线性 sRGBDensity = XYZDensity × 色彩矩阵&lt;br&gt;高度为零时只积分一次 XYZ&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1585" y="420" width="475" height="155" as="geometry" />
        </mxCell>
        <mxCell id="exposure" value="&lt;b&gt;共同曝光：保留物理量&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;g=fixedGain；0 时按两状态共同峰自动曝光&lt;br&gt;g ← g·2^exposureEV&lt;br&gt;原线性曝光 sRGB 保留为 color.sRGB&lt;br&gt;标准编码前裁剪到 sRGB 色域&lt;br&gt;原始 XYZ / xy 与 spectralEnergy 保留&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1585" y="640" width="475" height="155" as="geometry" />
        </mxCell>
        <mxCell id="enhance" value="&lt;b&gt;可选亮度显示增强&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;log 模式按 Y 计算亮度映射系数&lt;br&gt;XYZ/RGB 乘同一系数，再统一压缩高光&lt;br&gt;sRGB 编码 → displaySRGB&lt;br&gt;RGB 模式改用 plotComposeReflectionRgb&lt;br&gt;dB 图：10log10(e/e_ref)，同参考、同下限&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1585" y="860" width="475" height="170" as="geometry" />
        </mxCell>
        <mxCell id="colorout" value="&lt;b&gt;显示与物理数组分开保存&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;colorData：XYZ / xy / Density / sRGB / 映射&lt;br&gt;增强 RGB、线性曝光 sRGB、光谱合成图&lt;br&gt;receiver 图复用角度图 dB，X=zθ&lt;br&gt;局部放大仅裁切，不重新计算远场&lt;br&gt;原始 W/m² 存 result.spectralIrradiance&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEE9FA;strokeColor=#8A70B0;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1585" y="1095" width="475" height="170" as="geometry" />
        </mxCell>
        <mxCell id="export" value="&lt;b&gt;saveResults=true → Output/&amp;lt;项目&amp;gt;/&amp;lt;caseName&amp;gt;_*&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;主脚本第 7 节负责保存；同名输出会覆盖&lt;br&gt;高度为零输出单状态文件；非零高度增加 baseline / comparison 与两状态图片&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="555" y="1400" width="990" height="135" as="geometry" />
        </mxCell>
        <mxCell id="matout" value="&lt;b&gt;MAT：可继续分析的完整物理数据&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;_results.mat（-v7.3）：cfg、result、baseline、stack、&lt;br&gt;stackGeometry、spectrum、projectConfig、角域/光斑/色度结果&lt;br&gt;_layer_patterns.mat：layerMasks、layerNames、layerLevels&lt;br&gt;_config.txt：本次项目配置文本&lt;br&gt;物理数组保留未显示归一化数值&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEE9FA;strokeColor=#8A70B0;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1620" width="645" height="195" as="geometry" />
        </mxCell>
        <mxCell id="csvout" value="&lt;b&gt;CSV：定量核对与方案比较&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;_metrics；_reflection_metrics（单状态）&lt;br&gt;_baseline_metrics / _comparison_metrics（非零高度）&lt;br&gt;_observation_metrics；_cumulative_energy；_diffraction_spots&lt;br&gt;_stack_regions；_stack_materials&lt;br&gt;_spectrum（标准光谱路径）&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEE9FA;strokeColor=#8A70B0;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="725" y="1620" width="645" height="195" as="geometry" />
        </mxCell>
        <mxCell id="pngout" value="&lt;b&gt;PNG：几何、远场、颜色与指标&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;_geometry；_diffraction；_receiver_irradiance&lt;br&gt;_metrics；_cumulative_energy；_rgb&lt;br&gt;_d65_color 或 _spectral_color；_srgb_linear&lt;br&gt;非零高度的 RGB / 线性曝光图分别带状态后缀&lt;br&gt;图片是展示载体，定量比较应读取 MAT / CSV&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEE9FA;strokeColor=#8A70B0;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1410" y="1620" width="650" height="195" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ratio" target="zero">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="zero" target="haze">
