          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#3A8E77;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cie" target="spectrum">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#3A8E77;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="spectrum" target="weights">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#3A8E77;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="mat" target="input">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#3A8E77;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="images" target="stack">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#3A8E77;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="stack" target="lookup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#3A8E77;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="prop" target="physical">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#3A8E77;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="save" target="exports">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="开启基准" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="load" target="bench">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;阅读提示&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Q=实际出现的局部膜堆种类，L=波长数；输入错误会中止并关闭进度窗。archive/input_generation 为历史工具，不参与正式流程。&lt;/span&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#C58B45;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2030" width="1760" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="stack" name="02 图层到局部膜堆">
    <mxGraphModel dx="1800" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="2110" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;局部膜堆｜从二值图片到复反射系数 r(x,y,λ)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;对应 corePrepareLayerStack.m → coreReflectFilmStack.m；所有区域的复系数必须位于同一参考平面&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#173555;strokeColor=#173555;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=25;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1760" height="66" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="&lt;b&gt;A 几何与区域编码&lt;/b&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#D7E0EA;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=15;shadow=0;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="540" height="45" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;B 每个区域的膜堆计算&lt;/b&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#D7E0EA;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=15;shadow=0;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="115" width="540" height="45" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;C 核心公式与输出契约&lt;/b&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#D7E0EA;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=15;shadow=0;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1260" y="115" width="540" height="45" as="geometry" />
        </mxCell>
        <mxCell id="read" value="&lt;b&gt;1 读取 stack.layerNames / layerLevels&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;层级按从下到上排列；组内材料互斥&lt;br&gt;images：imread，RGB 通道均值，整数归一化&lt;br&gt;mat：按 layer.field 取二值图；full：整面覆盖&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="540" height="145" as="geometry" />
        </mxCell>
        <mxCell id="binary" value="&lt;b&gt;2 二值化与方向&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;mask_j = xor(value &amp;gt; threshold, invert)&lt;br&gt;MAT 输入要求原值为 0/1&lt;br&gt;所有图片尺寸、原点一致&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="repeat" value="&lt;b&gt;3 决定目标网格与显式平铺&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;shape=[periods_y, periods_x]×samplesPerPeriod&lt;br&gt;repeatToFit=false：图片必须等于目标尺寸&lt;br&gt;true：原尺寸为整 Pitch，目标能被原尺寸整除&lt;br&gt;仅 repmat，不缩放、不裁切、不改写输入&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="check" value="&lt;b&gt;4 校验层级与计算公共参考高度&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;同层每点 sum(mask_j) ≤ 1&lt;br&gt;H_ref = Σ每层级 max(d_j)&lt;br&gt;reflectance 的 d=0；nk 膜厚允许为 0&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="795" width="540" height="135" as="geometry" />
        </mxCell>
        <mxCell id="encode" value="&lt;b&gt;5 合并实际出现的图层组合&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;masks [Ny×Nx×J] → [NyNx×J]&lt;br&gt;unique(..., rows) 得 patterns [Q×J]&lt;br&gt;regionMap=reshape(regionIndex−1)&lt;br&gt;不枚举全部 2^J 个理论组合&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="areas" value="&lt;b&gt;6 每个局部区域的几何统计&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;AreaFraction = 区域像素数 / (NyNx)&lt;br&gt;LocalHeightM = patterns × thickness&lt;br&gt;unionMask=any(masks,3)，只作几何展示&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1205" width="540" height="140" as="geometry" />
        </mxCell>
        <mxCell id="material" value="&lt;b&gt;7 每层材料参数 → 波长网格&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;nk：N_j(λ)=n_j+iκ_j；d_j 固定&lt;br&gt;nkFile 非空优先，线性插值；必须覆盖全波段&lt;br&gt;reflectance：r_b=√R·exp(i·phaseDeg·π/180)&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="190" width="540" height="145" as="geometry" />
        </mxCell>
        <mxCell id="terminal" value="&lt;b&gt;8 每个区域选取底部终端&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;存在不透明 reflectance：取最上方反射边界&lt;br&gt;遮蔽其下方膜；记录底部高度 h_base&lt;br&gt;无该边界：medium 用 (n0−n_exit)/(n0+n_exit)&lt;br&gt;absorber 则用 r_b=0，进入终端的能量不返回&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="390" width="540" height="165" as="geometry" />
        </mxCell>
        <mxCell id="order" value="&lt;b&gt;9 按从入射侧到下方排列有限膜&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;只保留终端上方实际存在的 nk 膜&lt;br&gt;films=fliplr(present(~direct))&lt;br&gt;传给 coreReflectFilmStack 的高度 H=H_ref−h_base&lt;br&gt;从底层向入射侧递推；跳过 d=0 的膜&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="615" width="540" height="145" as="geometry" />
        </mxCell>
        <mxCell id="impedance" value="&lt;b&gt;10 将裸底反射系数变换到最底膜内&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;N_b 为最底膜复折射率，n0 为入射介质&lt;br&gt;r = [(N_b−n0)+(N_b+n0)r_b]&lt;br&gt;      / [(N_b+n0)+(N_b−n0)r_b]&lt;br&gt;没有有效有限膜时 r=r_b&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="820" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="recurse" value="&lt;b&gt;11 对每层 j 从底向上递推&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;r_int=(N_prev−N_j)/(N_prev+N_j)&lt;br&gt;q=r·exp(4πi N_j d_j/λ)&lt;br&gt;r ← (r_int+q)/(1+r_int·q)&lt;br&gt;N=n+iκ：传播相位与吸收同时计入&lt;br&gt;最上层的 N_prev=n0&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1040" width="540" height="185" as="geometry" />
        </mxCell>
        <mxCell id="reference" value="&lt;b&gt;12 补足共同参考平面的往返相位&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;g=max(0, H−Σ有效膜厚)&lt;br&gt;r_ref = r·exp(4πi n0 g/λ)&lt;br&gt;不同局部柱体必须保留相对相位&lt;br&gt;校验有限值及 |r_ref|≤1+容差&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1290" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="lookup" value="&lt;b&gt;13 写入模型查找表&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;coefficientLookup(q,k)=r_ref(q,λ_k)&lt;br&gt;遍历 Q 个区域、全部 L 个波长&lt;br&gt;regionMap 为 uint32，区域码从 0 开始&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1505" width="540" height="140" as="geometry" />
        </mxCell>
        <mxCell id="masks" value="&lt;b&gt;数据形状与常用结构&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;J=图层数；Q=实际区域数；L=波长数&lt;br&gt;layerMasks.(name) [Ny×Nx]，logical&lt;br&gt;patterns [Q×J]，nk [J×L]，thickness [1×J]&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="190" width="540" height="145" as="geometry" />
        </mxCell>
        <mxCell id="example" value="&lt;b&gt;默认层序实例：从上方入射&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;空气 n0&lt;br&gt;CF_R / CF_G / CF_B：同一层级、互斥&lt;br&gt;BM：吸收型有限膜&lt;br&gt;IJP：n=1.5、κ=0、d=10 μm，整面覆盖&lt;br&gt;Anode：R=1、phase=180° → r_b=−1&lt;/span&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#C58B45;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="390" width="540" height="190" as="geometry" />
        </mxCell>
        <mxCell id="phase" value="&lt;b&gt;三种相位的职责&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;① exp(4πi N_j d_j/λ)：有限膜往返相位&lt;br&gt;② exp(4πi n0 g/λ)：共同参考平面补偿&lt;br&gt;③ exp(4πi Δn·heightMap/λ)：传播阶段额外相位&lt;br&gt;heightMap=0 只关闭③，①②仍存在&lt;/span&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#C58B45;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="650" width="540" height="170" as="geometry" />
        </mxCell>
        <mxCell id="physics" value="&lt;b&gt;边界的物理含义&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;reflectance 是不透明有效边界，不能由 R 猜 t&lt;br&gt;absorber 的裸底 r=0；上覆膜界面仍可反射&lt;br&gt;透明 IJP 的 κ=0，仍有界面反射和干涉&lt;br&gt;medium 悬空膜未反射能量可向下透射&lt;br&gt;本模块主流程输出反射，不分解完整 R/T/A&lt;/span&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#C58B45;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="890" width="540" height="180" as="geometry" />
        </mxCell>
        <mxCell id="tables" value="&lt;b&gt;导出的可核对中间量&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;regionTable：RegionCode、AreaFraction、&lt;br&gt;LocalHeightM、各图层存在标志&lt;br&gt;materialTable：材料/层级/方法/λ/n/κ/d/R/phase&lt;br&gt;geometry：inputPeriods、repeatCounts、gridStep&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1140" width="540" height="170" as="geometry" />
        </mxCell>
        <mxCell id="map" value="&lt;b&gt;14 逐波长映射回复反射面&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;values=coefficientLookup(:,k)&lt;br&gt;r(x,y,λ_k)=values(regionMap+1)&lt;br&gt;结果 [Ny×Nx]，由光场相乘用于传播&lt;br&gt;外部 cfg.complexCoefficient 非空时优先覆盖&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEE9FA;strokeColor=#8A70B0;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1505" width="540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="convergence" value="&lt;b&gt;采样警告：厚膜光谱干涉&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;估计 Δφ=4π·光学厚度·max|Δ(1/λ)|&lt;br&gt;超过 π/2 时提示光谱可能欠采样&lt;br&gt;IJP=10 μm 时需检查波长步长收敛&lt;br&gt;不为消除警告改变真实膜厚&lt;/span&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#C58B45;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1505" width="540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="read" target="binary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="binary" target="repeat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="repeat" target="check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="check" target="encode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="encode" target="areas">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="material" target="terminal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="terminal" target="order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="order" target="impedance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="impedance" target="recurse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="recurse" target="reference">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="reference" target="lookup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="patterns / present" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#3A8E77;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="encode" target="terminal">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="1065" />
              <mxPoint x="620" y="470" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" value="H_ref" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#3A8E77;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="check" target="order">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="605" y="860" />
              <mxPoint x="605" y="685" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" value="[Q×L] + regionMap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#3A8E77;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=5 4;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="lookup" target="map">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="&lt;b&gt;阅读提示&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;主入口先构造所有局部膜堆系数，再进入高度状态和逐波长传播。材料数组给出的 κ 对应源码中的 k，图中写 κ 以免与波长索引 k 混淆。&lt;/span&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#C58B45;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=15;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2010" width="1760" height="65" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="propagation" name="03 照明与远场传播">
    <mxGraphModel dx="1800" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1840" pageHeight="2260" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;照明与传播｜复振幅 → 接收面每像素能量&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;coreSimulateHeightStates → coreSimulateDiffraction → coreBuildIllumination / corePropagateReceiver&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#173555;strokeColor=#173555;strokeWidth=1.5;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=25;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1760" height="66" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="&lt;b&gt;A 状态 / 网格 / 光源&lt;/b&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#D7E0EA;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=15;shadow=0;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="540" height="45" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;B 每波长、每源点的复场传播&lt;/b&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#D7E0EA;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=15;shadow=0;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="650" y="115" width="540" height="45" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;C 能量标定 / 非相干累加 / 诊断&lt;/b&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F2F5F9;strokeColor=#D7E0EA;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=18;align=left;verticalAlign=middle;spacing=15;shadow=0;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="1260" y="115" width="540" height="45" as="geometry" />
        </mxCell>
        <mxCell id="state" value="&lt;b&gt;1 确定高度状态 S&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;heightMap=0：S=1，baseline=result，复用结果&lt;br&gt;非零：S=2，先传播实际 heightMap&lt;br&gt;再将 heightMap=0 传播作为 baseline&lt;br&gt;膜堆复系数本身的相位始终不变&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="540" height="145" as="geometry" />
        </mxCell>
        <mxCell id="grid" value="&lt;b&gt;2 构建物面、光瞳和输出角度网格&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;dx=pitch/samplesPerPeriod；x,y 以 0 为中心&lt;br&gt;P(x,y)=1{x²+y²≤pupilRadius²}&lt;br&gt;N_P=ΣP²；A_inc=N_P·dx²&lt;br&gt;θ=linspace(−halfRange,+halfRange,M)，单位 rad&lt;br&gt;I_inc=cfg.incidentIrradiance；P_inc=I_inc·A_inc&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="395" width="540" height="165" as="geometry" />
        </mxCell>
        <mxCell id="source" value="&lt;b&gt;3 每波长生成空间照明模式&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;plane：一个均匀复场&lt;br&gt;point：球面路径差 + 距离/角度振幅衰减&lt;br&gt;有限圆盘：在圆内离散源点，等权重 w_s&lt;br&gt;laser：近轴 TEM00，高斯振幅 + 曲率相位&lt;br&gt;束腰或发散角二选一，随 λ 计算束参数&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="625" width="540" height="175" as="geometry" />
        </mxCell>
        <mxCell id="pointformula" value="&lt;b&gt;point 模式的具体场&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;ρ=物面点到源点投影的横向距离&lt;br&gt;R=√(z_s²+ρ²)，path=ρ²/(R+z_s)&lt;br&gt;a=(z_s/R)^(3/2)·exp[−ln2·(α/β)²/2]&lt;br&gt;E_s=a·exp(2πi·path/λ)，α=atan(ρ/z_s)&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="normalize" value="&lt;b&gt;4 按物面平均辐照度统一标定&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;c=√[N_P / Σ_s w_s Σ|P E_s|²]&lt;br&gt;E_s ← c E_s，Σw_s=1&lt;br&gt;Σ_s w_s Σ|P E_s|²=N_P&lt;br&gt;未知 LED 总功率不参与推测或换算&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1080" width="540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="&lt;b&gt;模型与采样检查&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;输出像素边界 + 入射倾角 ≤ λ/(2dx)&lt;br&gt;输出半角 ≤10°；laser 发散半角 ≤5°&lt;br&gt;局部入射 &amp;gt;5°：警告膜堆仍用法向系数&lt;br&gt;D²/(λ_min z)&amp;gt;0.5：提示夫琅禾费条件不足&lt;br&gt;观察窗口截断不会被强行归一化抹去&lt;/span&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#C58B45;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1300" width="540" height="180" as="geometry" />
        </mxCell>
        <mxCell id="loops" value="&lt;b&gt;5 循环：状态 → λ_k → 源点 s&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;λ 内的每个源点分别生成场、传播和取强度&lt;br&gt;同一个源点在物面上保持空间相干&lt;br&gt;不同源点间、不同波长间不叠加复振幅&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="190" width="540" height="145" as="geometry" />
        </mxCell>
        <mxCell id="field" value="&lt;b&gt;6 构造反射物面复振幅&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;r_k：由区域查表，或外部 complexCoefficient&lt;br&gt;E_in=P·E_s&lt;br&gt;φ_h=4π·Δn·heightMap/λ_k&lt;br&gt;E_ref=E_in·r_k·exp(iφ_h)&lt;br&gt;heightMap 全零时跳过额外相位乘法&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="395" width="540" height="165" as="geometry" />
        </mxCell>
        <mxCell id="bins" value="&lt;b&gt;7 自适应细分接收像素&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Δθ=相邻输出角中心间隔；D=最大物面宽度&lt;br&gt;q=max(receiverBinSamples, ceil(4DΔθ/λ))&lt;br&gt;q 调整为奇数；每像素 q×q 中点积分&lt;br&gt;细角网格覆盖每个输出像素完整边界&lt;br&gt;f_x,f_y=θ_fine/λ&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="625" width="540" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fourier" value="&lt;b&gt;8 二次相位卷积加速傅里叶积分&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;F(fx,fy)=Σ_y Σ_x E_ref(x,y)&lt;br&gt;                    ·exp[−2πi(fx x+fy y)]·dx·dy&lt;br&gt;transformColumns：先 x 再 y&lt;br&gt;chirp → FFT 卷积 → 相位修正&lt;br&gt;直接计算指定输出网格，不先粗 FFT 再插值&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="855" width="540" height="170" as="geometry" />
        </mxCell>
        <mxCell id="receiver" value="&lt;b&gt;9 夫琅禾费场与像素平均强度&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;U=exp(2πiz/λ)/(iλz)·F&lt;br&gt;细网格强度比 = |U|²&lt;br&gt;B_s=mean_{q×q}(|U|²)&lt;br&gt;接收坐标 X=zθ_x，Y=zθ_y；无接收面二次相位&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1090" width="540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="clear" value="&lt;b&gt;10 参考孔径并行数据支路&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;以 E_in 替换 E_ref，再走步骤 7–9&lt;br&gt;等价于理想 r=1、额外高度相位=0&lt;br&gt;得到 clearEnergy / clearKernel / clearPsf&lt;br&gt;用于参考，不把反射结果除以窗口捕获率&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1310" width="540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="next" value="&lt;b&gt;11 源点 → 波长 → 状态循环完成&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;每源点贡献按右侧公式加到本波长数组&lt;br&gt;本波长完成后计算 T、C、零级和锥外占比&lt;br&gt;完成所有波长，再做通道和色度积分&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1525" width="540" height="135" as="geometry" />
        </mxCell>
        <mxCell id="power" value="&lt;b&gt;主归一化约定&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;每个 λ 独立按相同 I_inc [W/m²] 标定&lt;br&gt;Pin=I_inc·A_inc&lt;br&gt;energy 是能量/功率比，无量纲&lt;br&gt;宽带真实谱形由归一化光谱权重在后续加入&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="190" width="540" height="145" as="geometry" />
        </mxCell>
        <mxCell id="throughput" value="&lt;b&gt;总反射与独立 Parseval 校验&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;T_k=Σ_s w_s Σ|E_ref|² / N_P&lt;br&gt;独立 FFT：e_fft=|FFT(E_ref)|²/(N_FFT² N_P)&lt;br&gt;误差=Σ_s w_s |Σe_fft−T_s|&lt;br&gt;反射模式 N_FFT=max(Nx,Ny)&lt;br&gt;该 FFT 只验能量，不生成接收面输出网格&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="395" width="540" height="165" as="geometry" />
        </mxCell>
        <mxCell id="sum" value="&lt;b&gt;接收能量与源点强度累加&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;A_bin=(zΔθ)²&lt;br&gt;e_s=B_s·A_bin/A_inc&lt;br&gt;energy(:,:,k) += w_s·e_s&lt;br&gt;spectralIrradiance(:,:,k) += w_s·I_inc·B_s&lt;br&gt;clearEnergy 同样按 w_s 累加&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1090" width="540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="metric" value="&lt;b&gt;逐波长输出与窗口捕获&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;spectralEnergy=energy [M×M×L]&lt;br&gt;C_k=Σ像素 energy(:,:,k)&lt;br&gt;CapturedFraction=C_k/T_k&lt;br&gt;I_pixel=energy·P_inc/A_bin，单位 W/m²&lt;br&gt;无源反射损失与窗口外能量均保留&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1310" width="540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="channels" value="&lt;b&gt;通道积分和形状归一化&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;W_kc = spectralWeights_k·channelResponse_kc&lt;br&gt;response_kc=W_kc/Σ_k W_kc&lt;br&gt;kernel(:,:,c)=Σ_k energy(:,:,k)·response_kc&lt;br&gt;psf=kernel/Σ像素kernel（仅形状，丢失总量）&lt;br&gt;channelSignal=kernel·Σ_k W_kc&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEE9FA;strokeColor=#8A70B0;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1525" width="540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;防止误读&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;paddingFactor 不控制正式反射输出采样&lt;br&gt;M 和 angleHalfRange 决定显示网格&lt;br&gt;q 控制每像素内部积分，保留窄峰能量&lt;br&gt;仅放大/裁切显示不会提高计算分辨率&lt;/span&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#C58B45;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1610" width="540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="handoff" value="&lt;b&gt;送往第 4 页：每个状态的 result&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;spectralEnergy / spectralIrradiance / metrics / kernel / psf / clearKernel / clearPsf&lt;br&gt;coordinate：近轴 rad；receiverCoordinate=z·coordinate：m&lt;br&gt;incidentArea / incidentPower / receiverPixelArea / receiverSamplesPerBin / illumination&lt;br&gt;若 S=1：后处理复用 baseline 对应字段，不重复传播、角积分或色度合成&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEE9FA;strokeColor=#8A70B0;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1820" width="1150" height="175" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="state" target="grid">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=20;html=1;endArrow=block;endFill=1;strokeColor=#42698C;strokeWidth=1.7;fontColor=#26435C;fontFamily=Microsoft YaHei;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="grid" target="source">
          <mxGeometry relative="1" as="geometry" />
