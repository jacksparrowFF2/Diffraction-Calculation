        <mxCell id="entry" value="&lt;b&gt;1 运行 COEReflection_main.m&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;初始化；选择 projectName / inputDir / outputDir&lt;br&gt;默认项目：Case1_Pitch64&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="190" width="540" height="105" as="geometry" />
        </mxCell>
        <mxCell id="defaults" value="&lt;b&gt;脚本默认值 + coeReflectionDefaults&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;几何、光谱、光源、膜堆、观察角域、显示参数&lt;br&gt;长度 m；角度 Deg 为 °；波长文件为 nm&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="190" width="540" height="125" as="geometry" />
        </mxCell>
        <mxCell id="config" value="&lt;b&gt;Input/&amp;lt;项目&amp;gt;/config.txt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;coreLoadProjectConfig：按白名单解析 key=value&lt;br&gt;覆盖脚本参数；未知/重复/类型错误即报错&lt;br&gt;不执行 MATLAB 表达式&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="365" width="540" height="135" as="geometry" />
        </mxCell>
        <mxCell id="load" value="&lt;b&gt;2 应用项目配置&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;useProjectConfig=true 时读取配置&lt;br&gt;在光谱和几何计算前生效&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="365" width="540" height="125" as="geometry" />
        </mxCell>
        <mxCell id="bench" value="&lt;b&gt;可选：runSamplingBenchmark=true&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;benchSampling（all）或 benchPeriods（periods）&lt;br&gt;写入 SamplingConvergence / PitchConvergence&lt;br&gt;随后 return，跳过下方正式仿真&lt;/span&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#C58B45;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="365" width="540" height="145" as="geometry" />
        </mxCell>
        <mxCell id="spectrum" value="&lt;b&gt;3 构造光谱 [详见第 4 页权重]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;D65 / custom / monochromatic → coreLoadSpectrum&lt;br&gt;RGB → 三波长代理；光谱与空间光源独立&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="560" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cie" value="&lt;b&gt;共享 CIE 数据 + 可选 SPD CSV&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Input/Colorimetry：D65、CIE 1931 2° CMF&lt;br&gt;custom CSV：波长 nm、相对谱功率&lt;br&gt;连续谱含梯形积分端点权重&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="weights" value="&lt;b&gt;spectrum + cfg 波长参数&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;wavelengths [1×L]；spectralWeights [1×L]&lt;br&gt;energyWeights / photopicWeights [L×1]&lt;br&gt;xyzWeights [L×3]&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="560" width="540" height="130" as="geometry" />
        </mxCell>
        <mxCell id="mat" value="&lt;b&gt;可选 Input/&amp;lt;项目&amp;gt;/&amp;lt;inputFile&amp;gt;.mat&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;加载 heightMap / complexCoefficient 等覆盖值&lt;br&gt;二维输入覆盖完整目标物面，行=y、列=x&lt;br&gt;正式主脚本禁止非空旧 mask&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="540" height="140" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;4 读取额外 MAT 并校验尺寸&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Nx=periods(1)×samplesPerPeriod&lt;br&gt;Ny=periods(2)×samplesPerPeriod&lt;br&gt;heightMap：标量或 Ny×Nx&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="760" width="540" height="125" as="geometry" />
        </mxCell>
        <mxCell id="images" value="&lt;b&gt;图层图片 + 材料输入&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Anode、IJP、BM、CF_R/G/B；可自定义名称&lt;br&gt;白色=材料，threshold / invert 控制二值化&lt;br&gt;n/k 常数、逐波长值或三列 nkFile CSV&lt;br&gt;各层厚度、层级和 nk/reflectance 方法&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="965" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="stack" value="&lt;b&gt;5 corePrepareLayerStack [详见第 2 页]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;对齐图片；显式平铺需 repeatToFit=true&lt;br&gt;相同层级互斥；实际图层组合编码&lt;br&gt;逐区域求相干膜堆复反射系数&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="965" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="lookup" value="&lt;b&gt;cfg.coeStack + stackGeometry&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;regionMap [Ny×Nx]：0 起始的区域码&lt;br&gt;coefficientLookup [Q×L]：复系数查找表&lt;br&gt;layerMasks / regionTable / materialTable&lt;br&gt;cfg.mask=unionMask，仅作显示&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="965" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="height" value="&lt;b&gt;6 coreSimulateHeightStates&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;heightMap 全零？只算一次，baseline=result&lt;br&gt;非零：计算有/无额外高度相位两状态&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1190" width="540" height="110" as="geometry" />
        </mxCell>
        <mxCell id="prop" value="&lt;b&gt;7 coreSimulateDiffraction [详见第 3 页]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;每个状态 → 每个波长 → 每个非相干源点&lt;br&gt;照明 × 复系数 × 额外相位 → 远场像素积分&lt;br&gt;理想参考孔径独立传播用于 clearEnergy&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1370" width="540" height="135" as="geometry" />
        </mxCell>
        <mxCell id="physical" value="&lt;b&gt;result / baseline：原始物理数组&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;spectralEnergy [M×M×L]：每像素能量/入射&lt;br&gt;spectralIrradiance [M×M×L]：W/m²&lt;br&gt;metrics、kernel、psf、坐标与照明信息&lt;br&gt;M=outputSize；保留窗口截断损失&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#E6F5F0;strokeColor=#3A8E77;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1370" width="540" height="145" as="geometry" />
        </mxCell>
        <mxCell id="post" value="&lt;b&gt;8 统计、色度与显示 [详见第 4 页]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;coreComputeAngularMetrics / DiffractionSpots&lt;br&gt;coreSynthesizeColor；RGB 则用代理显示&lt;br&gt;heightMap=0 时复用单状态积分和色度&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1575" width="540" height="135" as="geometry" />
        </mxCell>
        <mxCell id="save" value="&lt;b&gt;9 saveResults 控制导出&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Output/&amp;lt;项目&amp;gt;/&amp;lt;caseName&amp;gt;_*&lt;br&gt;保存配置、物理数组、指标与图片&lt;br&gt;未保存时结果仍留在 MATLAB 工作区&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#517BB8;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="650" y="1780" width="540" height="135" as="geometry" />
        </mxCell>
        <mxCell id="exports" value="&lt;b&gt;MAT / CSV / PNG&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;_results.mat；_layer_patterns.mat&lt;br&gt;指标、角域、累计能量、光斑、膜堆、光谱 CSV&lt;br&gt;几何、远场、接收面、颜色和曲线 PNG&lt;br&gt;曝光/对数增强不会回写物理能量&lt;/span&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#EEE9FA;strokeColor=#8A70B0;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1780" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="batch" value="&lt;b&gt;公共批量入口：runCOEReflection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;cfg, stack, inputDir → result&lt;br&gt;传 stack：先建局部膜堆，再计算高度状态&lt;br&gt;只传 cfg：保留历史参数调用路径&lt;br&gt;不自动读取项目 config.txt，不负责绘图/保存&lt;br&gt;图示正式主线来自 COEReflection_main.m&lt;/span&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#C58B45;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1480" width="540" height="190" as="geometry" />
        </mxCell>
        <mxCell id="current" value="&lt;b&gt;当前默认项目实例&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;64×64 Pitch，pitch=50 μm，dx=0.78125 μm&lt;br&gt;4096×4096 物面，3.2×3.2 mm，z=100 m&lt;br&gt;D65 380–780 nm / 5 nm → L=81&lt;br&gt;M=1201，±6°，heightMap=0，plane&lt;/span&gt;" style="shape=note;size=18;whiteSpace=wrap;html=1;fillColor=#FFF4E8;strokeColor=#C58B45;strokeWidth=1.5;fontColor=#18334C;fontFamily=Microsoft YaHei;fontSize=17;align=left;verticalAlign=middle;spacing=15;shadow=0;" vertex="1" parent="1">
